{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Matematicas Teacher",
  "version": "0.2.0",
  "identifier": "com.matematicas.teacher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Matemáticas Teacher",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "dist/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Aprende matematicas paso a paso en una pizarra",
    "longDescription": "Explica paso a paso como resolver problemas de matematicas, con una pizarra animada, balanza, pizzas y un chat de preguntas. La inteligencia artificial corre en la propia computadora, sin internet.",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/matematicas-teacher.desktop"
      }
    }
  }
}
